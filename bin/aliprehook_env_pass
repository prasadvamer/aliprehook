#!/bin/sh
# aliprehook_env_pass: pass variables from a hook to the main command.
#
#   aliprehook_env_pass [--allow-empty] [--hint TEXT] [NAME|NAME=value...] [--required NAME...] [--optional NAME...]
#
# NAME passes an exported variable from the hook; NAME=value sets and passes.
# Names are optional by default (missing value: warning). --required and
# --optional switch the mode for all names after them. A missing required
# value makes aliprehook stop the main command after the hook finishes.
# --allow-empty (anywhere) passes empty values instead of treating them as missing.
# --hint TEXT (anywhere, at most once) is shown after each missing required
# name's error, e.g. --hint "run: aws-login". Display only, never run.
#
# Exit: 0 ok (warnings allowed), 1 required value missing, 2 usage error.

set -u
prog=aliprehook_env_pass
hook=${ALIPREHOOK_HOOK:-hook}
hook=${hook##*/}
cmd=${ALIPREHOOK_COMMAND:-the command}

# --- Output theme ---------------------------------------------------------
# aliprehook passes its resolved theme as ALIPREHOOK_THEME_CODES ("role=code ...").
for pair in ${ALIPREHOOK_THEME_CODES:-}; do
  role=${pair%%=*}
  case $role in ''|*[!a-z_]*) continue ;; esac
  code=${pair#*=}
  case $code in *[!0-9\;]*) continue ;; esac
  eval "theme_$role=\$code"
done

color=0
case ${ALIPREHOOK_COLOR:-auto} in
  always) color=1 ;;
  never) ;;
  *) [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t 2 ] && color=1 ;;
esac

paint() {  # code text
  if [ "$color" = 1 ] && [ -n "$1" ]; then
    printf '\033[%sm%s\033[0m' "$1" "$2"
  else
    printf '%s' "$2"
  fi
}
role() { eval "printf '%s' \"\${theme_$1:-}\""; }

# msg <level> <part>... ; part: plain text (level color) or @role=text
msg() {
  level=$1
  shift
  tcode=$(role "$level")
  {
    paint "$(role brand)" aliprehook:
    printf ' '
    paint "${tcode:+1;$tcode}" "$level:"
    printf ' '
    for part do
      case $part in
        @*=*)
          r=${part%%=*}
          r=${r#@}
          paint "$(role "$r")" "${part#*=}"
          ;;
        *) paint "$tcode" "$part" ;;
      esac
    done
    printf '\n'
  } >&2
}

usage() {
  msg error "usage: $prog [--allow-empty] [--hint TEXT] [NAME|NAME=value...] [--required NAME...] [--optional NAME...]"
}

case ${1:-} in
  -h|--help)
    echo "usage: $prog [--allow-empty] [--hint TEXT] [NAME|NAME=value...] [--required NAME...] [--optional NAME...]"
    exit 0
    ;;
esac

if [ -z "${ALIPREHOOK_ENV_FILE:-}" ] || [ ! -f "$ALIPREHOOK_ENV_FILE" ] || [ ! -w "$ALIPREHOOK_ENV_FILE" ]; then
  msg error "@command=$prog" ": must be run from an aliprehook hook (ALIPREHOOK_ENV_FILE is not set)"
  exit 2
fi

# Pass 1: validate everything before writing anything.
allow_empty=0
names=0
hint=
hint_set=0
want_hint=0
for arg do
  if [ "$want_hint" -eq 1 ]; then
    want_hint=0
    if [ -z "$arg" ]; then
      msg error "@command=$prog" ": --hint needs a non-empty text"; usage; exit 2
    fi
    hint=$arg
    continue
  fi
  case $arg in
    --allow-empty) allow_empty=1 ;;
    --hint)
      if [ "$hint_set" -eq 1 ]; then
        msg error "@command=$prog" ": --hint given more than once"; usage; exit 2
      fi
      hint_set=1
      want_hint=1
      ;;
    --required|--optional) ;;
    -*) msg error "@command=$prog" ": unknown option: $arg"; usage; exit 2 ;;
    *)
      name=${arg%%=*}
      case $name in
        ''|[0-9]*|*[!A-Za-z0-9_]*) msg error "@command=$prog" ": invalid variable name: " "@var=$name"; exit 2 ;;
        ALIPREHOOK_*) msg error "@command=$prog" ": reserved variable name: " "@var=$name"; exit 2 ;;
      esac
      names=$((names + 1))
      ;;
  esac
done
if [ "$want_hint" -eq 1 ]; then
  msg error "@command=$prog" ": --hint needs a text"
  usage
  exit 2
fi
if [ "$names" -eq 0 ]; then
  usage
  exit 2
fi

nl='
'
write_var() {  # name value
  case $2 in
    *"$nl"*)
      while :; do
        delim=ALIPREHOOK_EOF_$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
        printf '%s\n' "$2" | grep -qxF "$delim" || break
      done
      printf '%s<<%s\n%s\n%s\n' "$1" "$delim" "$2" "$delim" >> "$ALIPREHOOK_ENV_FILE"
      ;;
    *)
      printf '%s=%s\n' "$1" "$2" >> "$ALIPREHOOK_ENV_FILE"
      ;;
  esac
}

# Pass 2: pass values, report missing ones.
mode=optional
status=0
skip=0
for arg do
  if [ "$skip" -eq 1 ]; then
    skip=0
    continue
  fi
  case $arg in
    --allow-empty) continue ;;
    --hint) skip=1; continue ;;
    --required) mode=required; continue ;;
    --optional) mode=optional; continue ;;
  esac

  case $arg in
    *=*)
      name=${arg%%=*}
      value=${arg#*=}
      isset=x
      ;;
    *)
      name=$arg
      eval "isset=\${$name+x}"
      eval "value=\${$name-}"
      ;;
  esac

  if [ -n "$isset" ] && { [ -n "$value" ] || [ "$allow_empty" -eq 1 ]; }; then
    write_var "$name" "$value"
  elif [ "$mode" = required ]; then
    if [ -n "$hint" ]; then
      msg error "@hook=$hook" ": " "@var=$name" " has no value (required) " "@hint=($hint)"
    else
      msg error "@hook=$hook" ": " "@var=$name" " has no value (required)"
    fi
    printf '!required-missing %s\n' "$name" >> "$ALIPREHOOK_ENV_FILE"
    status=1
  else
    msg warning "@hook=$hook" ": " "@var=$name" " has no value (unset, empty or not exported); not passed to " "@command=$cmd"
  fi
done

exit $status
